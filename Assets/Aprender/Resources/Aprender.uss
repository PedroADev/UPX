.app { flex-grow: 1; color: #26392f; font-size: 18px; -unity-font-style: normal; }
.screen { flex-grow: 1; background-color: #f7f7ef; }
.row { flex-direction: row; align-items: center; }
.spacer { flex-grow: 1; }
.card { background-color: #ffffff; border-radius: 22px; border-width: 1px; border-color: #e5e8df; }
Label { margin: 0; padding: 0; }
Button { margin: 0; border-width: 0; border-radius: 12px; padding: 12px 18px; color: #26392f; font-size: 17px; -unity-font-style: bold; background-color: #edf0e8; min-height: 48px; }
Button:hover { background-color: #e2e9da; }
Button:focus { border-width: 3px; border-color: #d6a94f; }
Button:active { background-color: #c8dda4; scale: 0.98 0.98; }
Button:disabled { opacity: 0.55; }
.primary { background-color: #2f614d; color: #ffffff; padding: 15px 23px; border-radius: 12px; }
.primary:hover { background-color: #3c735b; }
.primary:active { background-color: #28523f; }
.secondary { background-color: white; border-width: 1px; border-color: #d8dfd3; }
.secondary:hover { background-color: #f1f5eb; }
.quiet { background-color: transparent; color: #64716b; padding: 8px 12px; }
.quiet:hover { background-color: #eef2e8; }
.small-button { font-size: 13px; min-height: 38px; padding: 6px 10px; }
.eyebrow { font-size: 11px; letter-spacing: 2px; -unity-font-style: bold; color: #65746b; }
.tiny { font-size: 9px; letter-spacing: 1px; }
.muted { color: #758079; }
.body { font-size: 17px; white-space: normal; }
.small { font-size: 15px; white-space: normal; }
.hint { color: #7a857e; font-size: 12px; margin-top: 7px; white-space: normal; }
.wrap { white-space: normal; }
.title { font-size: 32px; -unity-font-style: bold; letter-spacing: -1px; margin-top: 12px; margin-bottom: 9px; white-space: normal; }
.guide-title { font-size: 19px; -unity-font-style: bold; margin-top: 8px; margin-bottom: 8px; white-space: normal; }
.brand { flex-shrink: 0; }
.brand-icon { width: 36px; height: 36px; background-color: #2f614d; color: #344b2b; border-radius: 11px; font-size: 31px; -unity-font-style: bold; -unity-text-align: middle-center; rotate: -9deg; }
.brand-name { font-size: 24px; letter-spacing: -1px; -unity-font-style: bold; margin-left: 11px; }
.login-header { justify-content: space-between; padding: 25px 50px 12px 50px; }
.login-scroll { flex-grow: 1; }
.login-scroll > .unity-scroll-view__content-viewport { flex-grow: 1; }
.login-columns { padding: 20px 50px 25px 50px; justify-content: center; align-items: stretch; }
.hero { width: 49%; max-width: 600px; padding: 24px 36px 0 0; }
.hero-title { font-size: 60px; letter-spacing: -2px; -unity-font-style: bold; margin-top: 18px; }
.hero-copy { font-size: 17px; color: #758079; margin-top: 19px; white-space: normal; }
.hero-art { position: relative; height: 270px; margin-top: 14px; overflow: hidden; }
.hero-pet { position: absolute; width: 265px; height: 265px; top: 10px; left: 28px; }
.login-card { width: 51%; max-width: 580px; padding: 22px 30px; }
.login-card .title { margin-top: 0; }
.field-title { font-size: 15px; -unity-font-style: bold; margin-top: 21px; margin-bottom: 9px; }
.text-input { height: 49px; margin: 0; font-size: 20px; }
.text-input > .unity-text-field__input { background-color: #f7f8f2; border-width: 1px; border-color: #dce2d6; border-radius: 10px; padding: 9px 13px; color: #26392f; }
.text-input > .unity-text-field__input:focus { border-color: #386d58; border-width: 2px; }
.text-input > .unity-text-field__input > .unity-text-element { -unity-text-align: middle-left; }
.code-row { align-items: stretch; }
.code-input { flex-grow: 1; width: 110px; margin-right: 10px; letter-spacing: 3px; }
.join-button { min-width: 135px; }
.pet-grid { flex-wrap: wrap; justify-content: space-between; }
.pet-choice { width: 15.8%; padding: 5px 2px; background-color: #f6f7f1; border-width: 2px; border-color: transparent; min-height: 90px; align-items: center; }
.pet-choice:hover { background-color: #eeefdf; }
.pet-choice.selected { border-color: #386d58; background-color: #e6eee2; }
.pet-thumb { width: 62px; height: 60px; }
.pet-name { font-size: 11px; color: #69756c; -unity-font-style: normal; }
.status { color: #a55236; font-size: 13px; white-space: normal; margin-top: 8px; }
.practice-button { background-color: transparent; color: #667c4c; border-top-width: 1px; border-top-color: #e8ece1; border-radius: 0; margin-top: 12px; min-height: 43px; font-size: 15px; }
.practice-button:hover { background-color: #f4f7ef; }
.teacher { margin-top: 8px; color: #7c857f; font-size: 12px; }
.teacher .unity-foldout__content { margin-left: 0; margin-top: 8px; }
.teacher .secondary { font-size: 13px; margin-top: 9px; min-height: 38px; }
.server-input { height: 40px; font-size: 13px; margin-top: 8px; }
.game-screen { background-color: transparent; }
.hud-top { background-color: rgba(255, 255, 255, 0.960784); padding: 17px 24px; border-bottom-width: 1px; border-bottom-color: #e2e7db; }
.hud-top .brand-name { font-size: 22px; }
.vertical-divider { height: 32px; width: 1px; background-color: #dde3d7; margin-left: 23px; margin-right: 23px; }
.location-title { font-size: 16px; -unity-font-style: bold; margin-top: 3px; }
.session-pill { background-color: #eef3e4; font-size: 11px; -unity-font-style: bold; color: #6b8055; border-radius: 20px; padding: 10px 14px; margin-right: 12px; }
.stars-pill { background-color: #fbefd0; color: #a17c28; border-radius: 18px; padding: 8px 14px; margin-right: 10px; -unity-font-style: bold; }
.help-button { width: 36px; min-height: 36px; padding: 4px; border-radius: 18px; font-size: 20px; background-color: #eef1e9; margin-left: 6px; margin-right: 6px; }
.world-guide { position: absolute; left: 24px; top: 108px; width: 269px; padding: 20px; }
.world-guide .eyebrow, .friends-card .eyebrow { font-size: 9px; letter-spacing: 1.4px; }
.world-guide .small { font-size: 13px; }
.world-guide .primary { margin-top: 16px; font-size: 15px; }
.subject-link { -unity-text-align: middle-left; background-color: #f5f6ef; border-left-width: 4px; border-radius: 9px; font-size: 15px; margin-top: 10px; padding: 12px; min-height: 46px; }
.friends-card { position: absolute; right: 24px; top: 108px; width: 223px; padding: 18px; max-height: 440px; overflow: hidden; }
.friend-row { margin-top: 12px; }
.friend-scroll { max-height: 310px; flex-shrink: 1; }
.friend-avatar { width: 42px; height: 42px; background-color: #f3f4eb; border-radius: 14px; }
.friend-info { flex-grow: 1; margin-left: 10px; }
.friend-name { font-size: 14px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; }
.friend-info .hint { margin-top: 2px; font-size: 10px; }
.online-dot { color: #83b66a; font-size: 12px; }
.friend-empty { font-size: 12px; margin-top: 18px; }
.hud-bottom { position: absolute; left: 24px; right: 24px; bottom: 22px; height: 55px; }
.key-hint { font-size: 12px; white-space: normal; color: #556b57; -unity-font-style: bold; padding: 11px 16px; background-color: rgba(255, 255, 255, 0.87451); border-radius: 10px; }
.interaction { min-width: 210px; }
.dpad { position: absolute; bottom: 100px; left: 24px; width: 140px; height: 95px; }
.direction { position: absolute; padding: 0; width: 43px; height: 43px; min-height: 43px; background-color: rgba(255, 255, 255, 0.862745); border-width: 1px; border-color: #d4dfcc; border-radius: 13px; font-size: 22px; }
.up { top: 0; left: 47px; }
.left { top: 47px; left: 0; }
.down { top: 47px; left: 47px; }
.right { top: 47px; left: 94px; }
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(35, 59, 55, 0.54902); align-items: center; justify-content: center; }
.modal-scroll { width: 100%; max-height: 100%; }
.modal-scroll .unity-scroll-view__content-container { align-items: center; padding: 30px; }
.modal { width: 800px; max-width: 100%; padding: 32px 38px; }
.modal > .body { margin-top: 9px; }
.quiz-choice { background-color: #f5f6ef; border-radius: 15px; padding: 18px 20px; margin-top: 18px; }
.quiz-info { flex-grow: 1; width: 60%; padding-right: 20px; }
.quiz-info .guide-title { margin-top: 0; }
.quiz-choice .primary { font-size: 15px; }
.progress-row { margin-top: 25px; margin-bottom: 30px; }
.progress-step { height: 6px; background-color: #e8ece1; flex-grow: 1; border-radius: 5px; margin-right: 7px; }
.progress-step.done { background-color: #a6c46d; }
.progress-step.current { background-color: #d6a94f; }
.question-count { color: #57705b; }
.question-text { font-size: 29px; -unity-font-style: bold; white-space: normal; margin-top: 12px; margin-bottom: 14px; }
.options { flex-wrap: wrap; justify-content: space-between; margin-top: 20px; }
.answer-choice { width: 48.8%; min-height: 84px; background-color: #f7f8f2; border-width: 2px; border-color: #e3e7db; border-radius: 15px; padding: 16px; margin-bottom: 13px; justify-content: flex-start; }
.answer-choice.selected { background-color: #e6eee2; border-color: #386d58; }
.answer-choice.correct { background-color: #eaf4d7; border-color: #93b85b; }
.answer-choice.try-again { background-color: #fbefdc; border-color: #d8b57c; }
.answer-choice:disabled { opacity: 1; }
.options:disabled { opacity: 1; }
.options:disabled .answer-text { color: #26392f; }
.options:disabled .answer-letter { color: #6d7a67; }
.answer-letter { width: 32px; height: 32px; background-color: white; color: #84917c; border-radius: 9px; -unity-text-align: middle-center; font-size: 15px; margin-right: 13px; flex-shrink: 0; }
.answer-text { font-size: 19px; white-space: normal; flex-shrink: 1; }
.question-actions { margin-top: 20px; }
.question-actions .hint { font-size: 12px; max-width: 220px; }
.feedback { border-radius: 12px; }
.feedback.success { background-color: #eff6e2; padding: 15px 19px; }
.feedback.learning { background-color: #fbf1e1; padding: 15px 19px; }
.feedback .guide-title { margin-top: 0; font-size: 17px; }
.feedback .body { font-size: 16px; }
.results-panel { width: 650px; align-items: center; padding: 40px; }
.results-panel Label { -unity-text-align: middle-center; }
.result-stars { font-size: 70px; color: #e1b848; letter-spacing: 9px; margin: 20px 0; }
.results-panel .title { font-size: 29px; }
.result-recap { padding: 18px; border-radius: 14px; background-color: #f6f7ef; margin: 24px 0; width: 100%; }
.results-panel .primary { width: 100%; }
.results-panel .quiet { margin-top: 8px; }
.help-panel { width: 640px; }
.help-panel .primary { margin-top: 25px; }
.help-copy { margin-top: 22px; margin-bottom: 12px; }
.compact .hero { display: none; }
.compact .login-card { width: 100%; max-width: 620px; }
.compact .login-header > .eyebrow { display: none; }
.compact .login-columns { padding-top: 10px; }
.compact .world-guide { width: 228px; padding: 16px; }
.compact .friends-card { width: 190px; }
.compact .hud-top { padding: 14px 18px; }
.compact .hud-top .brand-name { display: none; }
.compact .vertical-divider { margin-left: 16px; margin-right: 16px; }
.compact .session-pill { font-size: 10px; margin-right: 7px; }

/* Ilha do Saber: papel claro, tinta verde e sinais de matéria. */
.screen { background-color: #f4f0e4; }
.card { border-radius: 8px; border-color: #d8d8c9; }
Button { border-radius: 6px; min-height: 48px; border-width: 2px; border-color: transparent; }
Button:focus { border-width: 2px; border-color: #b18227; }
.primary { border-radius: 6px; color: white; }
.primary:hover { color: white; }
.quiet { border-radius: 5px; }
.title { font-size: 29px; letter-spacing: 0; }
.eyebrow { letter-spacing: 0.6px; font-size: 12px; }
.brand-icon { width: 34px; height: 34px; border-radius: 4px; font-size: 15px; letter-spacing: 1px; rotate: 0deg; background-color: #2f614d; color: white; }
.brand-name { font-size: 21px; letter-spacing: 0; }
.login-header { padding: 24px 42px 18px; border-bottom-width: 1px; border-bottom-color: #d9d9cb; }
.header-subjects { color: #6b7667; font-size: 14px; }
.login-columns { padding: 30px 42px; align-items: center; }
.hero { width: 43%; max-width: 500px; padding: 20px 50px 20px 0; }
.hero-title { font-size: 46px; letter-spacing: -1px; color: #244534; white-space: normal; }
.hero-copy { font-size: 20px; color: #526451; margin-top: 18px; }
.hero-art { height: 285px; margin-top: 18px; }
.pet-ground { position: absolute; background-color: #dedfbb; width: 270px; height: 72px; border-radius: 50%; top: 204px; left: 13px; }
.hero-pet { width: 290px; height: 285px; top: 0; left: 8px; }
.hero-note { font-size: 15px; color: #677460; white-space: normal; max-width: 330px; margin-top: 15px; }
.login-card { width: 57%; max-width: 590px; padding: 25px 28px; }
.field-title { margin-top: 17px; font-size: 16px; }
.text-input > .unity-text-field__input { border-radius: 5px; border-color: #bdc8b9; background-color: #fafbf6; }
.pet-choice { min-height: 91px; border-radius: 5px; background-color: #f1f2e8; }
.pet-choice.selected { border-color: #386d58; background-color: #e6eee2; }
.pet-name { font-size: 12px; color: #3e5542; }
.practice-button { width: 100%; margin-top: 17px; border-radius: 6px; font-size: 18px; background-color: #2f614d; color: white; border-top-width: 2px; border-top-color: transparent; }
.practice-button:hover { background-color: #3c735b; color: white; }
.classroom { margin-top: 20px; border-top-width: 1px; border-top-color: #d7ddcf; padding-top: 12px; }
.classroom > .unity-foldout__toggle { min-height: 42px; font-size: 16px; }
.classroom .unity-foldout__content { margin-left: 0; }
.teacher { font-size: 14px; }
.teacher > .unity-foldout__toggle { min-height: 40px; }
.hud-top { padding: 9px 20px; min-height: 62px; background-color: rgba(249, 249, 239, 0.97); }
.hud-top .brand-name { font-size: 19px; }
.location-title { margin-top: 0; font-size: 17px; }
.vertical-divider { height: 26px; margin-left: 18px; margin-right: 18px; }
.session-pill { border-radius: 4px; font-size: 12px; padding: 7px 11px; margin-right: 7px; background-color: #e8ecde; color: #3b5d42; }
.stars-pill { border-radius: 4px; padding: 7px 10px; font-size: 15px; }
.small-button { min-height: 42px; font-size: 13px; }
.world-guide { top: 82px; left: 20px; width: 215px; padding: 0; }
.world-guide > Foldout { padding: 9px 12px; background-color: rgba(249, 249, 239, 0.96); border-radius: 5px; border-width: 1px; border-color: #d0d8bd; }
.world-guide .unity-foldout__toggle { min-height: 32px; font-size: 15px; }
.world-guide .unity-foldout__content { margin-left: 0; }
.subject-link { margin-top: 8px; border-radius: 4px; min-height: 43px; }
.friends-card { top: 82px; right: 20px; padding: 9px 12px; border-radius: 5px; background-color: rgba(249, 249, 239, 0.96); width: 215px; }
.friends-card .unity-foldout__toggle { min-height: 32px; }
.friend-avatar { border-radius: 4px; }
.hud-bottom { bottom: 25px; left: 20px; right: 20px; }
.key-hint { font-size: 12px; border-radius: 4px; }
.dpad { opacity: 0.82; }
.controller-mode .dpad, .controller-mode .key-hint { display: none; }
.overlay { background-color: rgba(22, 42, 30, 0.65); }
.modal { border-radius: 8px; background-color: #fafbf4; }
.modal-scroll .unity-scroll-view__content-container { padding: 24px; }
.quiz-choice { border-radius: 5px; background-color: #ebeee2; }
.progress-step { border-radius: 0; height: 5px; }
.question-text { font-size: 28px; }
.answer-choice { border-radius: 6px; }
.answer-letter { border-radius: 4px; color: #3d5c43; }
.feedback { border-radius: 5px; }
.result-recap { border-radius: 5px; }
.result-stars { font-size: 60px; letter-spacing: 6px; }
.compact .hero { display: none; }
.compact .header-subjects { display: none; }
.compact .world-guide { width: 205px; padding: 0; }
.compact .friends-card { width: 200px; }
.compact .hud-top { padding: 8px 14px; }
.compact .login-columns { padding: 22px 28px; }
.controller-focus { border-width: 3px; border-color: #d5a23d; background-color: #faf2d7; }
.primary.controller-focus, .practice-button.controller-focus { background-color: #315e49; color: white; border-color: #e5ba5b; }
.controller-focus > .unity-text-field__input { border-color: #b18227; border-width: 3px; }
.controller-hint { position: absolute; bottom: 3px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 12px; padding: 5px 10px; color: #2c4533; background-color: rgba(250, 251, 244, 0.96); }
.controller-keyboard-overlay { position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: rgba(22, 42, 30, 0.78); align-items: center; justify-content: center; }
.controller-keyboard { width: 820px; max-width: 96%; padding: 20px; background-color: #f4f0e4; }
.controller-keyboard-title { font-size: 24px; margin-top: 0; }
.controller-keyboard-preview { background-color: white; padding: 12px 14px; min-height: 49px; margin-top: 8px; margin-bottom: 10px; font-size: 23px; color: #244534; border-width: 1px; border-color: #acbca3; }
.controller-keyboard-row { justify-content: center; margin-bottom: 5px; }
.controller-key { min-width: 48px; min-height: 45px; margin: 2px; padding: 6px 10px; background-color: white; }
.controller-keyboard-actions { justify-content: center; flex-wrap: wrap; margin-top: 10px; }
.controller-keyboard-actions Button { margin: 3px; padding: 8px 13px; }
.controller-keyboard-help { margin-top: 5px; }
.controller-keyboard-error { min-height: 18px; }
.screen.game-screen { background-color: transparent; }
.pet-choice.controller-focus, .answer-choice.controller-focus { border-color: #d5a23d; background-color: #faf2d7; }

/* iPhone: unidades de interface próximas a pontos, dentro da área segura. */
.mobile .safe-area { flex-direction: column; }
.mobile .screen { flex-grow: 1; }
.mobile Button { min-height: 52px; font-size: 16px; }
.mobile .hero, .mobile .header-subjects { display: none; }
.mobile .login-header { padding: 10px 16px; min-height: 48px; }
.mobile .brand-icon { width: 29px; height: 29px; font-size: 13px; }
.mobile .brand-name { font-size: 20px; }
.mobile .login-columns { padding: 4px 16px 12px; }
.mobile .login-card { width: 100%; max-width: 620px; padding: 12px 18px; }
.mobile .login-card > .title, .mobile .login-card > .hint { display: none; }
.mobile .title { font-size: 26px; }
.mobile .field-title { margin-top: 8px; margin-bottom: 5px; font-size: 16px; }
.mobile .text-input { height: 52px; font-size: 19px; }
.mobile .server-input { font-size: 16px; }
.mobile .pet-choice { min-height: 72px; padding: 3px 1px; }
.mobile .pet-thumb { width: 51px; height: 49px; }
.mobile .pet-name { font-size: 11px; }
.mobile .practice-button { margin-top: 10px; }
.mobile .classroom { margin-top: 10px; padding-top: 6px; }
.mobile .classroom > .unity-foldout__toggle, .mobile .teacher > .unity-foldout__toggle { min-height: 48px; }
.mobile .hud-top { padding: 3px 10px; min-height: 52px; }
.mobile .hud-top .brand, .mobile .hud-top .vertical-divider { display: none; }
.mobile .location-title { font-size: 16px; }
.mobile .hud-top Button { min-height: 44px; padding: 6px 9px; font-size: 13px; }
.mobile .session-pill { display: none; }
.mobile.online-session .session-pill { display: flex; padding: 6px; font-size: 10px; margin-right: 3px; }
.mobile .stars-pill { padding: 6px; font-size: 14px; margin-right: 3px; }
.mobile .world-guide { display: none; }
.mobile .friends-card { display: none; }
.mobile .hud-bottom { left: 168px; right: 14px; bottom: 18px; height: 56px; }
.mobile .hud-bottom Button { min-height: 52px; padding: 8px 12px; font-size: 14px; }
.mobile .key-hint { display: none; }
.mobile .interaction { min-width: 145px; }
.mobile .interaction .body { font-size: 14px; }
.mobile .touch-stick { position: absolute; left: 18px; bottom: 18px; width: 126px; height: 126px; border-radius: 63px; background-color: rgba(249, 249, 239, 0.78); border-width: 2px; border-color: #647d58; }
.mobile .touch-stick__knob { position: absolute; left: 50%; top: 50%; width: 54px; height: 54px; border-radius: 27px; background-color: #315e49; border-width: 2px; border-color: #f1f3df; }
.mobile .touch-stick.pressed { background-color: rgba(249, 249, 239, 0.94); border-color: #315e49; }
.mobile .touch-stick:disabled { opacity: 0.3; }
.mobile .modal-scroll .unity-scroll-view__content-container { padding: 12px; }
.mobile .modal { width: 680px; max-width: 100%; padding: 12px 18px; }
.mobile .question-text { font-size: 22px; margin-top: 8px; margin-bottom: 8px; }
.mobile .question-panel > .muted.body { display: none; }
.mobile .progress-row { margin-top: 8px; margin-bottom: 10px; }
.mobile .options { margin-top: 8px; }
.mobile .answer-choice { width: 32%; min-height: 64px; padding: 8px; margin-bottom: 8px; }
.mobile .answer-letter { width: 27px; height: 27px; margin-right: 8px; }
.mobile .answer-text { font-size: 17px; }
.mobile .question-actions { margin-top: 8px; }
.mobile .question-actions .hint { display: none; }
.mobile .feedback .body { font-size: 16px; }
.mobile .results-panel { width: 570px; }
.mobile .result-stars { margin: 10px 0; font-size: 48px; }
.mobile .result-recap { margin: 14px 0; padding: 12px; }
.mobile .quiz-choice { padding: 12px; margin-top: 12px; }
.mobile .quiz-info { padding-right: 12px; }
.mobile .controller-hint { font-size: 10px; }
.mobile .controller-keyboard { width: 700px; max-width: 96%; padding: 14px; }
.mobile .controller-key { min-width: 40px; min-height: 46px; padding: 5px; }
.mobile .controller-keyboard-overlay > ScrollView { width: 100%; max-height: 100%; }
.mobile .controller-keyboard-overlay .unity-scroll-view__content-container { align-items: center; padding: 10px; }
.mobile.keyboard-open .login-header { display: none; }
.mobile.keyboard-open .login-columns { padding-top: 8px; }
.mobile.short-screen .login-card { padding: 10px 18px; }
.mobile.short-screen .modal { padding: 12px 18px; }
.mobile .hud-top Button { min-height: 50px; }
.mobile .friends-card { display: flex; top: 64px; right: 12px; width: 175px; padding: 4px 9px; max-height: 210px; }
.mobile .friends-card .unity-foldout__toggle { min-height: 40px; }
.mobile .friend-scroll { max-height: 130px; }
